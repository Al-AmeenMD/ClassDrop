rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 1. Classroom Settings (Public read, Admin write)
    match /settings/{docId} {
      allow read: if docId == 'classroom';
      allow write: if docId == 'classroom' && isAdmin();
    }

    // 2. Administrative Resources Collection: Strictly accessible only to authenticated admins
    match /resources/{resourceId} {
      allow read, write: if isAdmin();
    }

    // 3. Public Resources Collection: Public read, Admin write
    match /public_resources/{resourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Download Logs: Admin read only, client writes disabled
    match /download_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 5. Admin Registry: Self-read only, client writes disabled
    match /admins/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}

